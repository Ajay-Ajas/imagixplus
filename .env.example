# ---- Server ----
NODE_ENV=development
PORT=4000
# Canonical public URL (canonical links, sitemap, Open Graph)
SITE_URL=https://imagix.civicmindai.in

# ---- PostgreSQL (Render provides DATABASE_URL) ----
DATABASE_URL=postgres://user:password@localhost:5432/imagixplus
# true only if your database provider requires SSL on the connection string you use
PGSSL=false

# ---- Sessions ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8

# ---- Persistent image storage (Cloudinary). Leave blank in development to store images in PostgreSQL ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Contact form email (any SMTP provider: Zoho, Brevo, Mailgun, Gmail app password, ...) ----
# Leave blank and the form still saves messages to the admin inbox, but tells visitors email is not active.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address shown as the sender. Must be allowed by your SMTP provider.
MAIL_FROM="IMAGIX+ <contact@civicmindai.in>"
# Where contact-form messages are delivered
CONTACT_TO=contact@civicmindai.in

# ---- First admin (read ONLY by `npm run create-admin`; remove afterwards) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
